# GitHub Repository
VITE_GITHUB_OWNER=Monutor
VITE_GITHUB_REPO=DataBaseProducts

# Admin password for the admin panel
VITE_ADMIN_PASSWORD=your_password_here

# GitHub Personal Access Token with repo scope (for public import flow)
VITE_PUBLIC_TOKEN=ghp_your_token_here

# ============================================================================
# WARNING — both values above are inlined into the PUBLIC client bundle.
#
# Vite replaces every import.meta.env.VITE_* with a string literal at build
# time, so the deployed dist/assets/index-*.js contains this password and this
# PAT in clear text. Anyone who opens the deployed site can read them and use
# the token against the API directly. The admin gate is client-side only and
# is bypassed by viewing the bundle source.
#
# This is an accepted, documented risk for this internal tool. Treat
# VITE_PUBLIC_TOKEN as fully public and keep its scope to the minimum that the
# import flow actually needs. Do not reuse these credentials anywhere else,
# and rotate both if they are ever exposed elsewhere.
# ============================================================================
